// ============================================================
// Check which APIs are configured
// ============================================================
const getAvailableAPIs = () => {
  const available = [];
  for (const [key, api] of Object.entries(APIS)) {
    if (api.key && api.key.length > 0) {
      api.isConfigured = true;
      available.push(key);
    } else {
      api.isConfigured = false;
    }
  }
  return available;
};

// ============================================================
// CALL API WITH AUTO-SWITCH
// ============================================================
async function callWithAutoSwitch(prompt, action) {
  const available = getAvailableAPIs();
  const order = ['gemini', 'groq', 'deepseek', 'openai'];
  const availableOrder = order.filter(api => APIS[api].isConfigured);
  
  if (availableOrder.length === 0) {
    throw new Error('No API keys configured. Please add at least one API key.');
  }
  
  console.log(`🔍 Available APIs: ${availableOrder.join(' → ')}`);
  console.log(`📝 Action: ${action}`);
  
  let lastError = null;
  
  for (const apiName of availableOrder) {
    const api = APIS[apiName];
    try {
      console.log(`🔄 Trying ${api.name}...`);
      const result = await api.call(prompt);
      console.log(`✅ ${api.name} succeeded!`);
      return result;
    } catch (error) {
      console.warn(`❌ ${api.name} failed:`, error.message);
      lastError = error;
    }
  }
  
  throw new Error(`All APIs failed. Last error: ${lastError?.message}`);
}

// ============================================================
// DETECT TOPIC
// ============================================================
async function detectTopic(text) {
  try {
    const prompt = `What is the main topic of this text? Return only the topic name (2-5 words), nothing else. TEXT: ${text.slice(0, 1000)}`;
    const result = await callWithAutoSwitch(prompt, 'topic-detection');
    return result.trim();
  } catch (error) {
    console.error('Topic detection error:', error);
    return 'Your topic';
  }
}

// ============================================================
// GENERATE BOTH LANGUAGES
// ============================================================
async function generateBothLanguages(text, topic, studentName) {
  const englishPrompt = `You are a friendly tutor named "LTC" talking to a student named ${studentName}.

STUDENT NAME: ${studentName}
TOPIC: ${topic}

Write in SIMPLE ENGLISH only (like explaining to a 5-year-old).
NO Pidgin at all! No "na", no "dey", no "wey".
Use proper English: "is", "are", "the", "this".

TEXT:
"""${text.slice(0, 6000)}"""

RULES:
- Start by saying: "${studentName}, this topic is about... [topic]"
- Call the student by name at least 3-4 times
- Use everyday analogies (market, traffic, cooking, factory, soup)
- Format technical terms like **[Term]** (Meaning: *simple explanation*)
- Make it feel like a friendly tutor talking to a student
- Do not add a title. Just the friendly explanation.`;

  const pidginPrompt = `You are a friendly tutor named "LTC" talking to a student named ${studentName}.

STUDENT NAME: ${studentName}
TOPIC: ${topic}

Write in NATURAL NIGERIAN PIDGIN ENGLISH only.
NO English at all! No "is", no "are", no "the".
Use words like "na", "dey", "wey", "abeg", "oya", "so", "o", "sef".

TEXT:
"""${text.slice(0, 6000)}"""

RULES:
- Start by saying: "${studentName}, this topic dey talk about... [topic]"
- Call the student by name at least 3-4 times
- Use everyday analogies (market, traffic, cooking, factory, soup)
- Format technical terms like **[Term]** (Meaning: *simple explanation*)
- Make it feel like a friendly tutor talking to a student
- Do not add a title. Just the friendly explanation.`;

  const [englishResult, pidginResult] = await Promise.all([
    callWithAutoSwitch(englishPrompt, 'cook-english'),
    callWithAutoSwitch(pidginPrompt, 'cook-pidgin')
  ]);

  return { english: englishResult, pidgin: pidginResult };
}

