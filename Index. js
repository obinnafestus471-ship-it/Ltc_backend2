      ? 'Write in NATURAL NIGERIAN PIDGIN ENGLISH only. NO English at all. Use "na", "dey", "wey", "abeg", "oya".'
      : 'Write in SIMPLE ENGLISH only. NO Pidgin at all. Use "is", "are", "the".';

    const intro = lang === 'pidgin'
      ? `${studentName}, no worry o! Make I explain am another way...`
      : `${studentName}, don\'t worry! Let me explain it another way...`;

    const prompt = `You are a friendly tutor named "LTC" talking to a student named ${studentName}.

The student said they don't understand this concept. This is breakdown level ${breakdownLevel}. Make it even SIMPLER.

${langInstruction}

CURRENT EXPLANATION:
"""${text}"""

RULES FOR LEVEL ${breakdownLevel}:
- Use even MORE everyday analogies (market, traffic, cooking, factory, soup)
- Use SMALLER words (like you're explaining to a 10-year-old)
- Add MORE examples from real life
- Start with: "${intro}"
- Call the student by name often
- If level > 2, break into tiny steps
- Keep the format: **[Term]** (Meaning: [Term]: *simple explanation*)

Write the new, simpler explanation:`;

    const simplified = await callWithAutoSwitch(prompt, 'breakdown');

    res.json({
      success: true,
      simplified: simplified,
      apiUsed: 'auto-switch'
    });

  } catch (error) {
    console.error('❌ Breakdown error:', error);
    res.status(500).json({ error: error.message });
  }
});

